# Where books, skills and eval runs live. Can point at a separate git repo.
LIBRARY_DIR=./library
# API server (also serves the MCP endpoint at /mcp)
PORT=4317
# Token for the HTTP MCP endpoint. Generated into .data/mcp-token when unset.
# MCP_TOKEN=
# Default models for headless Claude Code runs (aliases accepted by `claude --model`)
GENERATE_MODEL=sonnet
EVAL_MODEL=sonnet
JUDGE_MODEL=sonnet
